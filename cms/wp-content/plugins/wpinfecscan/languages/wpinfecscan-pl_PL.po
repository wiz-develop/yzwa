msgstr "<b style='color:red'>Wysoka</b>"

msgid "Real-time block history"
msgstr "Historia bloków w czasie rzeczywistym"

msgid "Attacked vulnerability type"
msgstr "Atakowany typ podatności"

msgid "Plugin"
msgstr "Wtyczka"

msgid "Theme"
msgstr "Motyw"

